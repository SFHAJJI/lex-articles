      "path": [],
      "article_valid_from": null,
      "text_md": "Article 1\n\nArticle 4 of Directive 2002/38/EC shall be replaced by the following:\n\n‘Article 4\n\nArticle 1 shall apply until 31 December 2006’.",
      "text_sha256": "77aa9ba6414a97d9a399f3b71b883d4e0150063967b7771a0caab44a9eed657c",
      "md_span": {
        "start": 702,
        "end": 842
      },
