    {
      "anchor": "art_2",
      "provision_id": "eu-eurlex:32008r1103:2008-10-22--10f0abff1e7cb53bb8eadcc4cbdd1fe72beda67f69adaf0107751e5cd40116cf#art_2",
      "eli": null,
      "type": "article",
      "num": null,
      "heading": null,
      "path": [],
      "article_valid_from": null,
      "text_md": "Article 2\n\nLes actes dont la liste figure à l'annexe sont adaptés, conformément à ladite annexe, à la décision 1999/468/CE, telle que modifiée par la décision 2006/512/CE.",
      "text_sha256": "af552a8efaec82909438eab5236b54fe5c3e78493dfd48fdab2242b324bbaadd",
      "md_span": {
        "start": 793,
