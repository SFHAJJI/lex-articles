      "provision_id": "eu-eurlex:32020l1504:2020-10-07--f8d4278bf11fb2783e866ef76ef9ebc65cbf5ca3d114066f5cd647241ccac690#art_2",
      "eli": null,
      "type": "article",
      "num": null,
      "heading": null,
      "path": [],
      "article_valid_from": null,
      "text_md": "Article 2\n\n1. Member States shall adopt and publish, by 10 May 2021, the laws, regulations and administrative provisions necessary to comply with Article 1 of this Directive.\n\nThey shall apply those measures from 10 November 2021.\n\n2. Member States shall communicate to the Commission and to the European Securities and Markets Authority (ESMA) the text of the main provisions of national law which they adopt in the field covered by this Directive.",
      "text_sha256": "675f74d1fca035881a30c298134dc840b65ed6b492592f0a25f84bad13481aad",
