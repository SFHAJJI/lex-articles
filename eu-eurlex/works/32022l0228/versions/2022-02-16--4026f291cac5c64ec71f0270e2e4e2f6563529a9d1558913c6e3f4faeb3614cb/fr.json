      "article_valid_from": null,
      "text_md": "Article premier\n\nL’article 20 de la directive 2014/41/UE est supprimé.",
      "text_sha256": "005137e5fa52851e83344deacea28328a72a10be33c380d67d8e55275eb9b762",
      "md_span": {
        "start": 634,
