      "eli": null,
      "type": "article",
      "num": null,
      "heading": null,
      "path": [],
      "article_valid_from": null,
      "text_md": "Article 2\n\nLa Commission réexamine le présent règlement à la lumière du progrès technologique et de l’innovation, du déploiement des équipements et de ses incidences sur les objectifs en matière d’énergies renouvelables.",
      "text_sha256": "e424ee64d012cccb8c41543e8e93e8c289790b4ffaa1a28da0775b3454962364",
      "md_span": {
