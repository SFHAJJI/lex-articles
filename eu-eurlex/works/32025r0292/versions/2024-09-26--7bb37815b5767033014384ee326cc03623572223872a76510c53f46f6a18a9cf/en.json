      "provision_id": "eu-eurlex:32025r0292:2024-09-26--7bb37815b5767033014384ee326cc03623572223872a76510c53f46f6a18a9cf#art_2",
      "eli": null,
      "type": "article",
      "num": null,
      "heading": null,
      "path": [],
      "article_valid_from": null,
      "text_md": "Article 2\n\nWhere competent authorities rely on an administrative arrangement pursuant to Article 46(3), point (b), of Regulation (EU) 2016/679 for the transfer of personal data to supervisory authorities of third countries, that arrangement shall be annexed to the cooperation arrangement entered into in accordance with Article 107(1) of Regulation (EU) 2023/1114.",
      "text_sha256": "32bb0d39e2b04da3b58458dfcb03157b7750856cdd24f77ad9a830e3db5a3d53",
      "md_span": {
