      "provision_id": "lu-legilux:loi-1873-12-18-n3:2002-01-01--633756e5934d0ef90c6555911fc2688f7e55aa1f8955e9be1f6ca59dc41880a1#art_6",
      "eli": "http://data.legilux.public.lu/eli/etat/leg/loi/1873/12/18/n3/art_6/20020101",
      "type": "article",
      "num": "Art. 6.",
      "heading": null,
      "path": [],
      "article_valid_from": "2002-01-01",
      "text_md": "L'arrêté royal du 22 septembre 1823 est abrogé.",
