      "anchor": "art_1er",
      "provision_id": "lu-legilux:loi-1999-05-31-n6:2002-01-01--4d83f0d94954cc68120cee0bba4d491a3ae228417d6ddeb85bf32d7fd7e3a726#art_1er",
