  "language": "fr",
  "title": "Version consolidée applicable au 22/05/2022 : Règlement gand-ducal du 20 juin 1963 rendant obligatoire la déclaration des causes de décès.",
  "valid_from": "2022-05-22",
  "valid_to": null,
  "valid_time_source": "publisher",
  "derived_from": {
    "corpus_repo": "lex-corpus-lu-legilux",
