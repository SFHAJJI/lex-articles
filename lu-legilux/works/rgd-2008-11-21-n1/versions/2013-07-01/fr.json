      "heading": null,
      "path": [],
      "article_valid_from": "2013-07-01",
      "text_md": "L'indemnité visée à l'article 11 de la loi du 21 novembre 2008 portant création d'une Commission consultative des Droits de l'Homme du Grand-Duché de Luxembourg est fixée à 18,75 euros.",
      "text_sha256": "22ee6057958d329a19e648c61326453b4ac170cc4d7ae85b6450972fa40da8aa",
      "md_span": {
        "start": 695,
        "end": 880
      },
