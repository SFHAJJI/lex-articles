      "heading": null,
      "path": [],
      "article_valid_from": "2018-06-10",
      "text_md": "Notre Ministre de l’Agriculture, de la Viticulture et de la Protection des consommateurs est chargé de l’exécution du présent règlement qui sera publié au Journal officiel du Grand-Duché de Luxembourg.",
      "text_sha256": "878189ab54afcaa36485c1df0a55e34d85bd45ec2ac3166e0dcacad1fe927eb7",
