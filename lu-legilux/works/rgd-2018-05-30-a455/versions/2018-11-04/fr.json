    },
    {
      "anchor": "art_11",
      "provision_id": "lu-legilux:rgd-2018-05-30-a455:2018-11-04#art_11",
      "eli": "http://data.legilux.public.lu/eli/etat/leg/rgd/2018/05/30/a455/art_11/20180610",
      "type": "article",
