      "heading": null,
      "path": [],
      "article_valid_from": "2022-09-21",
      "text_md": "Le présent règlement produit ses effets au 21 septembre 2022.",
      "text_sha256": "28d1b027afbd2068dd2a148fa087db2384da23d214e64c6e2518c6ecffbcaa35",
      "md_span": {
