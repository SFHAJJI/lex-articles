  "provisions": [
    {
      "anchor": "art_1er",
      "provision_id": "lu-legilux:rgd-2024-07-31-a364:2026-07-01#art_1er",
      "eli": "http://data.legilux.public.lu/eli/etat/leg/rgd/2024/07/31/a364/art_1er/20260701",
      "type": "article",
      "num": "Art. 1er.",
      "heading": null,
      "path": [],
      "article_valid_from": "2026-07-01",
      "text_md": "Le Grand-Duché de Luxembourg contribue à la mission d’assistance militaire de l’Union européenne au Mozambique (EUMAM Mozambique) à partir du 1er juillet 2026 jusqu’au 30 juin 2028.",
      "text_sha256": "4868843e1e8cb4f313f3e4f5f62856f2fc0ee977fbe2492221b33cfb73dcf48b",
      "md_span": {
        "start": 712,
        "end": 893
      },
      "citations": []
    },
    {
      "anchor": "art_2",
      "provision_id": "lu-legilux:rgd-2024-07-31-a364:2026-07-01#art_2",
      "eli": "http://data.legilux.public.lu/eli/etat/leg/rgd/2024/07/31/a364/art_2/20240901",
      "type": "article",
      "num": "Art. 2.",
      "heading": null,
      "path": [],
      "article_valid_from": "2024-09-01",
      "text_md": "La contribution luxembourgeoise comprend au maximum cinq membres de l’Armée luxembourgeoise.",
      "text_sha256": "fcfb6f013793d360314f9cae0c64c1862175a83ef43a19c8e829e8a83b60236b",
      "md_span": {
        "start": 928,
        "end": 1020
      },
      "citations": []
    },
    {
      "anchor": "art_3",
      "provision_id": "lu-legilux:rgd-2024-07-31-a364:2026-07-01#art_3",
      "eli": "http://data.legilux.public.lu/eli/etat/leg/rgd/2024/07/31/a364/art_3/20240901",
      "type": "article",
      "num": "Art. 3.",
      "heading": null,
      "path": [],
      "article_valid_from": "2024-09-01",
      "text_md": "Sur proposition du chef d’état-major de l’Armée luxembourgeoise, le ministre ayant la Défense dans ses attributions désigne les membres de l’Armée luxembourgeoise participant à la mission.",
      "text_sha256": "3d50c03ba9bf2f7c5756fd3b4ac7e06bf79243c0a71c9e48b7850cde48258a7b",
      "md_span": {
        "start": 1055,
        "end": 1243
      },
      "citations": []
    },
    {
      "anchor": "art_4",
      "provision_id": "lu-legilux:rgd-2024-07-31-a364:2026-07-01#art_4",
      "eli": "http://data.legilux.public.lu/eli/etat/leg/rgd/2024/07/31/a364/art_4/20240901",
      "type": "article",
      "num": "Art. 4.",
      "heading": null,
      "path": [],
      "article_valid_from": "2024-09-01",
      "text_md": "La mission des membres de l’Armée luxembourgeoise consiste en la contribution de capacités de communication satellitaire et en l’intervention ponctuelle des membres de l’Armée pour l’installation, la mise en œuvre et la maintenance de cette capacité satellitaire.",
      "text_sha256": "b77fd4790fffd50daffa9edb501c29da68606726aa35b39b039c0b0822c820b7",
      "md_span": {
        "start": 1278,
        "end": 1541
      },
      "citations": []
    },
    {
      "anchor": "art_5",
      "provision_id": "lu-legilux:rgd-2024-07-31-a364:2026-07-01#art_5",
      "eli": "http://data.legilux.public.lu/eli/etat/leg/rgd/2024/07/31/a364/art_5/20240901",
      "type": "article",
      "num": "Art. 5.",
      "heading": null,
      "path": [],
      "article_valid_from": "2024-09-01",
      "text_md": "Pour la durée de leur mission, les membres de l’Armée luxembourgeoise appliquent les directives de la mission et restent placés sous l’autorité hiérarchique nationale.",
      "text_sha256": "3368bb41e5bec0a4e3c805535c90ea0fd4327b12243f4bc99c5728193e8ebe8f",
      "md_span": {
        "start": 1576,
        "end": 1743
      },
      "citations": []
    },
    {
      "anchor": "art_6",
      "provision_id": "lu-legilux:rgd-2024-07-31-a364:2026-07-01#art_6",
      "eli": "http://data.legilux.public.lu/eli/etat/leg/rgd/2024/07/31/a364/art_6/20240901",
      "type": "article",
      "num": "Art. 6.",
      "heading": null,
      "path": [],
      "article_valid_from": "2024-09-01",
      "text_md": "Les membres de l’Armée luxembourgeoise ont droit à l’indemnité mensuelle spéciale non imposable et non pensionnable, prévue à l’article 9 de la loi modifiée du 27 juillet 1992 relative à la participation du Grand-Duché de Luxembourg à des opérations pour le maintien de la paix et des opérations de prévention, ainsi que de gestion de crise.",
      "text_sha256": "6354a0d062d711a93bce6f583db90a18e8376459984f96aab88871c1330986ab",
      "md_span": {
        "start": 1778,
        "end": 2119
      },
      "citations": [
        {
          "href": "/eli/etat/leg/loi/1992/07/27/n5/jo",
          "text": "loi modifiée du 27 juillet 1992"
        }
      ]
    },
    {
      "anchor": "art_7",
      "provision_id": "lu-legilux:rgd-2024-07-31-a364:2026-07-01#art_7",
      "eli": "http://data.legilux.public.lu/eli/etat/leg/rgd/2024/07/31/a364/art_7/20240901",
      "type": "article",
      "num": "Art. 7.",
      "heading": null,
      "path": [],
      "article_valid_from": "2024-09-01",
      "text_md": "Les membres de l’Armée luxembourgeoise bénéficient d’un congé spécial fin de mission conformément à l’article 17*bis* de la loi modifiée du 27 juillet 1992 relative à la participation du Grand-Duché de Luxembourg à des opérations pour le maintien de la paix et des opérations de prévention, ainsi que de gestion de crise.",
      "text_sha256": "6a822f0b3dc905c864e603e89d1fb520026e66d46cd0761ed66c4143f83cfa1a",
      "md_span": {
        "start": 2154,
        "end": 2475
      },
      "citations": [
        {
          "href": "/eli/etat/leg/loi/1992/07/27/n5/jo",
          "text": "loi modifiée du 27 juillet 1992"
        }
      ]
    },
    {
      "anchor": "art_8",
      "provision_id": "lu-legilux:rgd-2024-07-31-a364:2026-07-01#art_8",
      "eli": "http://data.legilux.public.lu/eli/etat/leg/rgd/2024/07/31/a364/art_8/20240901",
      "type": "article",
      "num": "Art. 8.",
      "heading": null,
      "path": [],
      "article_valid_from": "2024-09-01",
      "text_md": "Le ministre ayant les Affaires étrangères et le Commerce extérieur dans ses attributions et le ministre ayant la Défense dans ses attributions sont chargés, chacun en ce qui le concerne, de l’exécution du présent règlement qui sera publié au Journal officiel du Grand-Duché de Luxembourg.",
      "text_sha256": "7d36dfc0f804e94a8ed3075d71909e5d221a1abaa22de46588d2c0670ba70340",
      "md_span": {
        "start": 2510,
        "end": 2798
      },
      "citations": []
    }
  ],
  "notes": []
}
